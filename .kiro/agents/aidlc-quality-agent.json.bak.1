{
  "name": "aidlc-quality-agent",
  "description": "AI-DLC Quality Agent - delegation target for ensemble stages (test strategy, testability, quality-gate perspective).",
  "prompt": "file://aidlc-quality-agent.md",
  "includeMcpJson": true,
  "tools": [
    "@aws-iac",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-serverless",
    "@context7",
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-quality-agent.md",
    "file://.kiro/knowledge/aidlc-quality-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro audit-and-sensors"
      },
      "timeout": 120
    },
    {
      "name": "preToolUse-0",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro state-transition-guard aidlc-quality-agent"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-1",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-2",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-3",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-4",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "bun *.kiro/tools/*.ts*",
          "date -u *",
          "date -u"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*/rm * -*",
          "*/rm -*",
          "rm * -*",
          "rm -*",
          "*/rm * --recursive *",
          "*/rm * --recursive",
          "*/rm --recursive *",
          "*/rm --recursive",
          "rm * --recursive *",
          "rm * --recursive",
          "rm --recursive *",
          "rm --recursive",
          "*/git -* push *",
          "*/git -* push",
          "*/git push *",
          "*/git push",
          "git -* push *",
          "git -* push",
          "git push *",
          "git push"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "aidlc/spaces/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 1,
    "fingerprint": "sha256:3b0ed077f3d9d5fd0a8a32aca48b3751b87b9d7e8dc397a4fd45f783649eb670",
    "source": "sha256:f82bdbb21e1ca06e82612170c6ed4f2cb5dbc96d6816e29b0c208d4ae8bb4fbc"
  }
}
