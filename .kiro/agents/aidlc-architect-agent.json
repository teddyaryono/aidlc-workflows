{
  "name": "aidlc-architect-agent",
  "description": "AI-DLC Architect Agent — delegation target for the reverse-engineering (2.1) synthesis step. Use for delegated architecture-analysis tasks.",
  "prompt": "file://aidlc-architect-agent.md",
  "includeMcpJson": true,
  "tools": [
    "@aws-iac",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-serverless",
    "@context7",
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-architect-agent.md",
    "file://.kiro/knowledge/aidlc-architect-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro audit-and-sensors"
      },
      "timeout": 120
    },
    {
      "name": "preToolUse-0",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro state-transition-guard aidlc-architect-agent"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-1",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-2",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-3",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-4",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "bun *.kiro/tools/*.ts*",
          "date -u *",
          "date -u"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*/rm * -*",
          "*/rm -*",
          "rm * -*",
          "rm -*",
          "*/rm * --recursive *",
          "*/rm * --recursive",
          "*/rm --recursive *",
          "*/rm --recursive",
          "rm * --recursive *",
          "rm * --recursive",
          "rm --recursive *",
          "rm --recursive",
          "*/git -* push *",
          "*/git -* push",
          "*/git push *",
          "*/git push",
          "git -* push *",
          "git -* push",
          "git push *",
          "git push"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "aidlc/spaces/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:670028a57396421f20f5d4a94419c3708f364969647a1c31a335040ac470aed3",
    "source": "sha256:e9a969b9dcf72a77003aa4a65a2f066175254de8b587ee58416c4e1c6dd96d46"
  }
}
