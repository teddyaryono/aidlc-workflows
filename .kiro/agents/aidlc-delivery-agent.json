{
  "name": "aidlc-delivery-agent",
  "description": "AI-DLC Delivery Agent - delegation target for ensemble stages (delivery planning, sequencing, approval-handoff perspective).",
  "prompt": "file://aidlc-delivery-agent.md",
  "includeMcpJson": true,
  "tools": [
    "@aws-iac",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-serverless",
    "@context7",
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-delivery-agent.md",
    "file://.kiro/knowledge/aidlc-delivery-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro audit-and-sensors"
      },
      "timeout": 120
    },
    {
      "name": "preToolUse-0",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro state-transition-guard aidlc-delivery-agent"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-1",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-2",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-3",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-4",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "bun *.kiro/tools/*.ts*",
          "date -u *",
          "date -u"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*/rm * -*",
          "*/rm -*",
          "rm * -*",
          "rm -*",
          "*/rm * --recursive *",
          "*/rm * --recursive",
          "*/rm --recursive *",
          "*/rm --recursive",
          "rm * --recursive *",
          "rm * --recursive",
          "rm --recursive *",
          "rm --recursive",
          "*/git -* push *",
          "*/git -* push",
          "*/git push *",
          "*/git push",
          "git -* push *",
          "git -* push",
          "git push *",
          "git push"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "aidlc/spaces/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:d586e1a782ce2cd0269ac7483854c9a9e806962a6bc8b9791be65a3d0d59fbf4",
    "source": "sha256:70a5b675f60ad0d24a6b3f84ca06da86c56feb06cf75e08f2dab02bc0ec1860d"
  }
}
